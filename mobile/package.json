{
  "name": "plan-your-trip-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:dev:lan": "expo start --dev-client --lan",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "eas:ios:preview": "eas build --profile preview --platform ios",
    "eas:android:preview": "eas build --profile preview --platform android"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.19",
    "@rnmapbox/maps": "~10.2.10",
    "@sentry/react-native": "^7.4.0",
    "@tanstack/react-query": "^5.90.2",
    "babel-preset-expo": "~54.0.10",
    "dotenv": "~16.4.5",
    "expo": "^54.0.13",
    "expo-constants": "^18.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "^55.0.17",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "^8.0.8",
    "expo-router": "^6.0.14",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "^55.0.18",
    "expo-status-bar": "^3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
